---
interface Props {
	height?: string
	class?: string
}

const { height = '30%', class: className } = Astro.props

const BLUR_LEVELS = [0.5, 1, 2, 4, 8, 16, 32, 64]
const BAND = 12.5

const layers = BLUR_LEVELS.map((blur, index) => {
	if (index === 0) {
		return {
			blur,
			mask: `linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,1) ${BAND}%, rgba(0,0,0,1) ${BAND * 2}%, rgba(0,0,0,0) ${BAND * 3}%)`
		}
	}

	if (index === BLUR_LEVELS.length - 1) {
		return {
			blur,
			mask: `linear-gradient(to bottom, rgba(0,0,0,0) ${BAND * 7}%, rgba(0,0,0,1) 100%)`
		}
	}

	const start = index * BAND
	const mid = (index + 1) * BAND
	const end = (index + 2) * BAND

	return {
		blur,
		mask: `linear-gradient(to bottom, rgba(0,0,0,0) ${start}%, rgba(0,0,0,1) ${mid}%, rgba(0,0,0,1) ${end}%, rgba(0,0,0,0) ${end + BAND}%)`
	}
})
---

<div
	class:list={[
		'pointer-events-none absolute inset-x-0 bottom-0 z-10',
		className
	]}
	style={{ height }}
	aria-hidden="true"
>
	{
		layers.map(({ blur, mask }, index) => (
			<div
				class="absolute inset-0"
				style={{
					zIndex: index + 1,
					backdropFilter: `blur(${blur}px)`,
					WebkitBackdropFilter: `blur(${blur}px)`,
					maskImage: mask,
					WebkitMaskImage: mask
				}}
			/>
		))
	}
</div>
