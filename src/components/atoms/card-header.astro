---
interface Props {
	class?: string
	[key: string]: unknown
}

const { class: className = '', ...rest }: Props = Astro.props

const BASE =
	'group/card-header grid auto-rows-min items-start gap-1 rounded-t-xl px-4 [.border-b]:pb-4'
---

<div data-slot="card-header" class={`${BASE} ${className}`} {...rest}>
	<slot />
</div>
