---
const CONTAINER =
	'fixed inset-x-0 top-0 z-50 hidden h-1 supports-[animation-timeline:scroll()]:block motion-reduce:hidden'

const BAR =
	'block h-full origin-left scale-x-0 bg-primary [animation-fill-mode:both] [animation-name:reading-progress] [animation-timeline:scroll(root_block)] [animation-timing-function:linear]'
---

<div class={CONTAINER} aria-hidden="true">
	<span class={BAR}></span>
</div>
