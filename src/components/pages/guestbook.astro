---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { AppLayout } from '@components/layouts'
import { Button, Card, CardContent } from '@components/atoms'
import {
	canonical as canonicalUrl,
	schema,
	type PageSeo
} from '@lib/seo'
import { useTranslations, type Locale } from '@lib/i18n'
import {
	EMPTY_STATE,
	type GuestbookState,
	type GuestbookError,
	recentEntries,
	LIMITS
} from '@lib/server'

interface Props {
	locale: Locale
	state?: GuestbookState
	signed?: boolean
}

const { locale, state = EMPTY_STATE, signed = false } = Astro.props

const t = useTranslations(locale)

const { errors, values } = state
const entries = recentEntries()

const errorText: Record<GuestbookError, string> = {
	name_required: t('guestbook_error_name'),
	name_too_long: t('guestbook_error_name_long', { max: LIMITS.name.max }),
	message_required: t('guestbook_error_message'),
	message_too_long: t('guestbook_error_message_long', {
		max: LIMITS.message.max
	}),
	duplicate: t('guestbook_error_duplicate')
}

const title = `${t('guestbook_title')} — r3p.dev`
const description =
	'Leave a note if you stopped by. A small, plain guestbook for visitors to say hello, share feedback, or just sign their name.'
const canonical = canonicalUrl('/guestbook', locale)

const seo: PageSeo = {
	path: '/guestbook',
	locale,
	title,
	description,
	jsonLd: [
		...schema.siteNodes(description),
		schema.webPage({ canonical, name: title, description, breadcrumb: true }),
		schema.breadcrumbList(canonical, [
			{ name: t('nav_home'), path: getRelativeLocaleUrl(locale, '/') },
			{ name: t('guestbook_title'), path: getRelativeLocaleUrl(locale, '/guestbook') }
		])
	]
}

const countLabel =
	entries.length === 1
		? t('guestbook_note_count_one', { count: entries.length })
		: t('guestbook_note_count_other', { count: entries.length })

const field =
	'w-full rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive'

const asDate = (iso: string) => new Date(`${iso.replace(' ', 'T')}Z`)
---

<AppLayout seo={seo}>
	<div class="space-y-12">
		<div class="space-y-4">
			<h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				{t('guestbook_title')}
			</h1>
			<p class="max-w-prose text-muted-foreground">{t('guestbook_lead')}</p>
		</div>

		<section class="space-y-4" aria-labelledby="sign-heading">
			<h2 id="sign-heading" class="text-xl font-semibold text-foreground">
				{t('guestbook_sign_heading')}
			</h2>

			{
				signed && (
					<p
						role="status"
						class="rounded-lg border border-border bg-card px-4 py-3 text-sm text-foreground"
					>
						{t('guestbook_thanks')}
					</p>
				)
			}

			<form method="POST" class="max-w-xl space-y-4">
				<div class="space-y-2">
					<label for="name" class="block text-sm font-medium text-foreground">
						{t('guestbook_name')}
					</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						minlength={LIMITS.name.min}
						maxlength={LIMITS.name.max}
						autocomplete="nickname"
						value={values.name}
						aria-invalid={errors.name ? 'true' : undefined}
						aria-describedby={errors.name ? 'name-error' : undefined}
						class={field}
					/>
					{
						errors.name && (
							<p id="name-error" class="text-sm text-destructive">
								{errorText[errors.name]}
							</p>
						)
					}
				</div>

				<div class="space-y-2">
					<label
						for="message"
						class="block text-sm font-medium text-foreground"
					>
						{t('guestbook_message')}
					</label>
					<textarea
						id="message"
						name="message"
						rows="4"
						required
						minlength={LIMITS.message.min}
						maxlength={LIMITS.message.max}
						aria-invalid={errors.message ? 'true' : undefined}
						aria-describedby={errors.message ? 'message-error' : undefined}
						class={field}>{values.message}</textarea
					>
					{
						errors.message && (
							<p
								id="message-error"
								role="alert"
								class="text-sm text-destructive"
							>
								{errorText[errors.message]}
							</p>
						)
					}
				</div>

				<div hidden aria-hidden="true">
					<label for="website">{t('guestbook_honeypot')}</label>
					<input
						id="website"
						name="website"
						type="text"
						tabindex="-1"
						autocomplete="off"
					/>
				</div>

				<Button type="submit">{t('guestbook_submit')}</Button>
			</form>
		</section>

		<section class="space-y-4" aria-labelledby="entries-heading" id="entries">
			<h2 id="entries-heading" class="text-xl font-semibold text-foreground">
				{countLabel}
			</h2>

			{
				entries.length === 0 ? (
					<p class="text-muted-foreground">{t('guestbook_empty')}</p>
				) : (
					<ul class="space-y-4">
						{entries.map((entry) => (
							<li>
								<Card>
									<CardContent class="space-y-2">
										<div class="flex flex-wrap items-baseline justify-between gap-2">
											<span class="font-medium text-foreground">
												{entry.name}
											</span>
											<time
												datetime={asDate(entry.created_at).toISOString()}
												class="text-xs text-muted-foreground"
											>
												{new Intl.DateTimeFormat(
													locale === 'id' ? 'id-ID' : 'en-GB',
													{
														day: '2-digit',
														month: 'short',
														year: 'numeric',
														timeZone: 'UTC'
													}
												).format(asDate(entry.created_at))}
											</time>
										</div>
										<p class="text-sm wrap-break-word whitespace-pre-line text-muted-foreground">
											{entry.message}
										</p>
									</CardContent>
								</Card>
							</li>
						))}
					</ul>
				)
			}
		</section>
	</div>
</AppLayout>
