---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { render } from 'astro:content'
import { Image } from 'astro:assets'

import {
	canonical as canonicalUrl,
	pageTitle,
	schema,
	type PageSeo
} from '@lib/seo'
import { useTranslations, type Locale } from '@lib/i18n'
import { formatDate, isoDay, type Project } from '@lib/content'
import { Badge, Button, Icon, ReadingIndicator } from '@components/atoms'
import { AppLayout } from '@components/layouts'
import { ImageLightbox, Toc } from '@components/organisms'
import CodeCopy from '@components/code-copy.astro'

interface Props {
	locale: Locale
	project: Project
}

const { locale, project } = Astro.props
const t = useTranslations(locale)

const { Content, headings } = await render(project)
const image = project.data.cover

const path = `/projects/${project.id}`
const canonical = canonicalUrl(path, locale)
const published = isoDay(project.data.date)
const modified = project.data.updated ? isoDay(project.data.updated) : published

const seo: PageSeo = {
	path,
	locale,
	title: pageTitle(project.data.title),
	description: project.data.description,
	type: 'article',
	published,
	modified,
	tags: project.data.tags,
	imageAlt: project.data.title,
	jsonLd: [
		...schema.siteNodes(project.data.description),
		schema.webPage({
			canonical,
			name: project.data.title,
			description: project.data.description,
			breadcrumb: true,
			dateModified: modified
		}),
		schema.breadcrumbList(canonical, [
			{ name: t('nav_home'), path: getRelativeLocaleUrl(locale, '/') },
			{
				name: t('page_projects_title'),
				path: getRelativeLocaleUrl(locale, '/projects')
			},
			{ name: project.data.title, path: getRelativeLocaleUrl(locale, path) }
		])
	]
}
---

<ReadingIndicator />

<AppLayout seo={seo} width="wide">
	<article class="space-y-8 pt-12 2xl:pt-0">
		<header class="space-y-6 border-b border-border pb-8">
			<div
				class="relative h-64 w-full overflow-hidden rounded-xl bg-muted sm:h-80"
			>
				{
					image && (
						<Image
							src={image}
							widths={[640, 1024, 2048]}
							sizes="(max-width: 1024px) 100vw, 1024px"
							loading="eager"
							fetchpriority="high"
							alt={project.data.title}
							class="h-full w-full object-cover"
						/>
					)
				}
			</div>

			<div class="space-y-4">
				<div class="space-y-2">
					<h1
						class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl"
					>
						{project.data.title}
					</h1>
					<p class="text-lg text-muted-foreground">
						{project.data.description}
					</p>
				</div>

				<div
					class="flex flex-col gap-4 pt-4 sm:flex-row sm:items-center sm:justify-between"
				>
					<div class="flex items-center gap-2 text-sm text-muted-foreground">
						<Icon name="calendar" class="size-4" />
						<time datetime={published}
							>{formatDate(project.data.date, locale)}</time
						>
					</div>

					<div class="flex gap-2">
						{
							project.data.repository && (
								<Button
									href={project.data.repository}
									target="_blank"
									rel="external noopener"
									variant="outline"
									class="gap-2 text-foreground"
								>
									<Icon name="brand-github" class="size-4" />
									{t('projects_repository')}
								</Button>
							)
						}
						{
							project.data.demo && (
								<Button
									href={project.data.demo}
									target="_blank"
									rel="external noopener"
									class="gap-2"
								>
									<Icon name="world-www" class="size-4" />
									{t('projects_demo')}
								</Button>
							)
						}
					</div>
				</div>

				<div class="flex flex-wrap gap-2 pt-2">
					{
						project.data.tags.map((tag) => (
							<Badge
								variant="secondary"
								href={getRelativeLocaleUrl(locale, `/tags/${tag}`)}
							>
								{tag}
							</Badge>
						))
					}
				</div>
			</div>
		</header>

		<div class="prose max-w-none leading-relaxed text-muted-foreground">
			<Content />
		</div>

		<footer class="border-t border-border pt-8">
			<a
				href={getRelativeLocaleUrl(locale, '/projects')}
				class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
			>
				<Icon name="arrow-left" class="size-4" />
				{t('projects_back')}
			</a>
		</footer>
	</article>

	<Toc headings={headings} locale={locale} />
	<CodeCopy locale={locale} />
	<ImageLightbox locale={locale} />
</AppLayout>
