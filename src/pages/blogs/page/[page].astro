---
import type { GetStaticPaths } from 'astro'

import BlogsPage from '../../../components/pages/blogs-page.astro'
import { allBlogs, blogPage, totalPages } from '../../../lib/content/utils'
import { defaultLocale } from '@lib/i18n'

export const getStaticPaths = (async () => {
	const blogs = await allBlogs(defaultLocale)
	const pages = totalPages(blogs.length)

	const numbers = Array.from({ length: Math.max(0, pages - 1) }, (_, index) => index + 2)

	return numbers.map((page) => ({
		params: { page: String(page) },
		props: blogPage(blogs, page)
	}))
}) satisfies GetStaticPaths

const { blogs, page, totalPages: pages, total } = Astro.props
---

<BlogsPage
	locale={defaultLocale}
	blogs={blogs}
	page={page}
	totalPages={pages}
	total={total}
/>
