---
import type { GetStaticPaths } from 'astro'

import BlogsPage from '../../../../components/pages/blogs-page.astro'
import { allBlogs, blogPage, totalPages } from '../../../../lib/content/utils'
import { langParams } from '../../../../lib/routes'

export const getStaticPaths = (async () => {
	const routes = await Promise.all(
		langParams().map(async ({ params, props }) => {
			const blogs = await allBlogs(props.locale)
			const pages = totalPages(blogs.length)

			const numbers = Array.from(
				{ length: Math.max(0, pages - 1) },
				(_, index) => index + 2
			)

			return numbers.map((page) => ({
				params: { ...params, page: String(page) },
				props: { ...props, ...blogPage(blogs, page) }
			}))
		})
	)

	return routes.flat()
}) satisfies GetStaticPaths

const { locale, blogs, page, totalPages: pages, total } = Astro.props
---

<BlogsPage locale={locale} blogs={blogs} page={page} totalPages={pages} total={total} />
