---
import type { GetStaticPaths } from 'astro'

import TagDetail from '../../../components/pages/tag-detail.astro'
import { allTags, taggedEntries } from '../../../lib/content/utils'
import { langParams } from '../../../lib/routes'

export const getStaticPaths = (async () => {
	const routes = await Promise.all(
		langParams().map(async ({ params, props }) => {
			const tags = await allTags(props.locale)

			return Promise.all(
				tags.map(async (tag) => ({
					params: { ...params, slug: tag },
					props: {
						...props,
						tag,
						items: await taggedEntries(tag, props.locale)
					}
				}))
			)
		})
	)

	return routes.flat()
}) satisfies GetStaticPaths

const { locale, tag, items } = Astro.props
---

<TagDetail locale={locale} tag={tag} items={items} />
