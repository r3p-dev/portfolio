---
import type { GetStaticPaths } from 'astro'

import ProjectDetail from '../../../components/pages/project-detail.astro'
import { allProjects } from '../../../lib/content/utils'
import { langParams } from '../../../lib/routes'

export const getStaticPaths = (async () => {
	const projects = await allProjects()

	return langParams().flatMap(({ params, props }) =>
		projects.map((project) => ({
			params: { ...params, slug: project.id },
			props: { ...props, project }
		}))
	)
}) satisfies GetStaticPaths

const { locale, project } = Astro.props
---

<ProjectDetail locale={locale} project={project} />
