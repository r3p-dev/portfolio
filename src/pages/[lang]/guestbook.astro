---
import Guestbook from '@components/pages/guestbook.astro'
import { toLocale } from '@lib/i18n'
import { EMPTY_STATE, handleSubmission, readOwner, readView } from '@lib/server'

export const prerender = false

const locale = toLocale(Astro.currentLocale)

let state = EMPTY_STATE

if (Astro.request.method === 'POST') {
	const result = await handleSubmission(
		Astro.request,
		Astro.cookies,
		Astro.url.pathname
	)

	if (result instanceof Response) return result

	state = result
}

const view = readView(Astro.url, state)
const owner = readOwner(Astro.cookies)
---

<Guestbook locale={locale} state={state} owner={owner} {...view} />
